# Multi-Candidate LinkedIn Bot - Example .env
# Copy this file to .env and configure your local credentials.

# Candidate 1 Credentials (matches candidate id in config/candidates.yaml)
CANDIDATE_001_PASSWORD=your_password_here

# Candidate 2 Credentials
CANDIDATE_002_PASSWORD=your_password_here

# Proxy Credentials (if using authenticated proxies)
PROXY_BRIGHTDATA_PASSWORD=your_proxy_password
PROXY_OXYLABS_PASSWORD=your_proxy_password
PROXY_SMARTPROXY_PASSWORD=your_proxy_password

# Single-Candidate / Legacy Configuration (for config.yaml or fallback)
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_password
PHONE_NUMBER=1234567890
